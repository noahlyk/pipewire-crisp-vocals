# One-shot first-run config bootstrap: copies the shipped example config to
# ~/.config/pipewire/crisp-vocals.ron (only if it doesn't already exist) and
# fills in hardware.mic_node_name from the current default audio source.
# Runs as a USER unit (not a PKGBUILD post_install hook) because it needs a
# real invoking user's HOME/XDG_CONFIG_HOME and a running user session to
# query @DEFAULT_AUDIO_SOURCE@ via wpctl -- both of which a root-context
# PKGBUILD hook cannot reliably obtain. See README.md's setup section.
[Unit]
Description=crisp-vocals first-run config setup
Documentation=https://github.com/noahlyk/pipewire-crisp-vocals
After=pipewire.service wireplumber.service
ConditionPathExists=!%h/.config/pipewire/crisp-vocals.ron

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/crisp-vocals/first-run-setup.sh

[Install]
WantedBy=default.target
