# pipewire-crisp-vocals: the single unit for the whole stack -- supervises
# both processes of the one crisp-vocals binary, `crisp-vocals dsp` (DSP
# chain, config hot-reloaded from ~/.config/pipewire/crisp-vocals.ron) and
# `crisp-vocals links` (declarative PipeWire auto-wiring, config read from
# the same file), via a small wrapper script. Config is auto-bootstrapped on
# first run by the processes themselves -- no separate setup unit.
# After a package upgrade, `crisp-vocals --version` says whether the running
# processes are still the old build; `systemctl --user restart
# pipewire-crisp-vocals.service` picks up the new one.
[Unit]
Description=crisp-vocals dedicated mic processing + auto-wiring
Documentation=https://github.com/noahlyk/pipewire-crisp-vocals
After=pipewire.service
Requires=pipewire.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/lib/crisp-vocals/pipewire-crisp-vocals-wrapper.sh
Restart=on-failure
RestartSec=3
# Explicit RT scheduling instead of relying solely on rtkit's dynamic
# promotion. Requires membership in the `audio` group (or an equivalent
# /etc/security/limits.d grant of rtprio 95 + unlimited memlock); if this
# unit fails to start with "Failed to set up special execution directive",
# drop these four lines and restart.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=88
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=pipewire.service
