// crisp-vocals.ron — DSP chain + wiring config, hot-reloaded on save.
//
// Installed here by the package as a `.example` template; the
// `crisp-vocals-setup.service` user unit copies it to
// ~/.config/pipewire/crisp-vocals.ron on first run (never overwriting an
// existing one) and fills in `hardware.mic_node_name` from your current
// default audio source. Edit freely after that -- crisp-vocals and
// crisp-links both hot-reload/re-read from that path.
(
    preamp_db: 12.0,
    // active_mode: "raw",
    // active_mode: "instrumental",
    active_mode: "vocals",

    // This machine's hardware wiring, read by crisp-links.
    hardware: (
        // Physical mic's PipeWire node name (substring match), e.g.
        // "Komplete", "USB PnP Audio Device". Filled in automatically on
        // first run from @DEFAULT_AUDIO_SOURCE@ -- see
        // crisp-vocals-setup.service. Blank = crisp-links won't route a
        // physical mic into crisp-vocals until this is set.
        mic_node_name: "",
    ),

    // Optional: MIDI-keyboard-triggered synth fan-in (on-demand fluidsynth
    // into vinput). Delete this whole block, or set enabled: false, if you
    // don't use a MIDI keyboard.
    synth: (
        enabled: false,
        soundfont_path: "/usr/share/soundfonts/FluidR3_GM.sf2",
        midi_keyboard_name: "",
    ),

    linking: (
        enabled: true,
        only_edit_links_on_node_init: true,
    ),

    modes: {
        "raw": (
            stages: [
                (type: "stereo2mono", enabled: true, mode: "peak"),
            ],
        ),
        "vocals": (
            stages: [
                (type: "stereo2mono", enabled: true, mode: "peak"),
                (type: "rnnoise", enabled: true),
                (
                    type: "expander",
                    enabled: true,
                    threshold_db: -52.0,
                    ratio: 2.5,
                    knee_db: 10.0,
                    range_db: -16.0,
                    attack_ms: 3.0,
                    release_ms: 150.0,
                    detector_ms: 10.0,
                ),
                (
                    type: "compressor",
                    enabled: true,
                    threshold_db: -18.0,
                    ratio: 3.5,
                    makeup_db: 0.0,
                    knee_db: 4.0,
                    attack_ms: 4.0,
                    release_ms: 30.0,
                ),
                (
                    type: "gate",
                    enabled: true,
                    threshold_db: -55.0,
                    ratio: 6.0,
                    knee_db: 8.0,
                    range_db: -20.0,
                    hysteresis_db: 8.0,
                    hold_ms: 350.0,
                    attack_ms: 4.0,
                    release_ms: 150.0,
                    detector_ms: 10.0,
                    detector: "expander",
                ),
                (
                    type: "eq",
                    enabled: true,
                    preamp_db: 2.0,
                    band: [
                        (type: "LS", freq: 60,   gain_db: -2.9, q: 0.71),
                        (type: "PK", freq: 130,  gain_db: 1.7,  q: 2.4),
                        (type: "PK", freq: 245,  gain_db: 3.1,  q: 1.1),
                        (type: "PK", freq: 1650, gain_db: -9.4, q: 4.4),
                        (type: "HS", freq: 8300, gain_db: 2.2,  q: 1.3),
                    ],
                ),
            ],
        ),
        "instrumental": (
            stages: [
                (type: "stereo2mono", enabled: true, mode: "peak"),
                (
                    type: "eq",
                    enabled: true,
                    preamp_db: -5.0,
                ),
            ],
        ),
    },
)
